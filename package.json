{
  "name": "quicktix-root",
  "version": "1.0.0",
  "private": true,
  "description": "QuickTix - Mini support-ticket tracker with Playwright E2E and CI/CD",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project chromium",
    "test:server": "playwright test --project server-unit",
    "test:client": "npm run test --prefix client -- --watch=false",
    "test:unit": "npm run test:server && npm run test:client",
    "test:smoke": "playwright test --project chromium --grep @smoke",
    "test:functional": "playwright test --project chromium playwright/login/functional",
    "test:ui-browser": "playwright test --project chromium playwright/login/ui-browser",
    "test:visual": "playwright test --project chromium --grep @visual",
    "test:api": "playwright test --project chromium --grep @api",
    "test:security": "playwright test --project chromium --grep @security",
    "test:ui": "playwright test --ui --project chromium --project server-unit",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix server && npm run build --prefix client"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.7",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
